# Copy to .env. Never commit .env or paste a key into browser code.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT_SECONDS=35
MEDHUB_AGENT_ENABLED=true

# Local development: python server.py
MEDHUB_ENV=development
MEDHUB_HOST=127.0.0.1
MEDHUB_PORT=8000
MEDHUB_ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Production requires https origins and a random secret (32+ characters).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
MEDHUB_SIGNING_SECRET=
MEDHUB_RATE_LIMIT=20
MEDHUB_RATE_WINDOW_SECONDS=60
MEDHUB_MAX_CONCURRENT_AGENTS=4
MEDHUB_THREADS=8

# Private aggregate metrics; no patient answers, IP or identifiers are stored.
# Set a separate random token to enable GET /api/metrics with Bearer authorization.
ADMIN_TOKEN=
MEDHUB_METRICS_DB=data/metrics.sqlite3
